# ============================================================
# SILENT SYNDICATE — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your real values
# NEVER commit .env to git
# ============================================================

# ActiveCampaign API Credentials
# Find these at: Account Settings > Developer > API Access
AC_API_KEY=your_activecampaign_api_key_here
AC_BASE_URL=https://youraccountname.api-us1.com

# ActiveCampaign List IDs
# Find at: Lists > your list > right-click > Properties > ID
AC_LIST_ID=your_main_list_id
AC_DIST_LIST_ID=your_distributor_list_id

# ActiveCampaign Automation IDs
# Find at: Automations > your automation > URL contains the ID
AC_AUTOMATION_ID=your_welcome_automation_id
AC_HOT_AUTOMATION_ID=your_hot_lead_routing_automation_id
AC_WARM_AUTOMATION_ID=your_warm_nurture_automation_id

# ActiveCampaign Tag IDs (optional - system will create tags if not specified)
AC_HOT_TAG_ID=your_hot_tag_id
AC_WARM_TAG_ID=your_warm_tag_id
AC_APPLIED_TAG_ID=your_applied_tag_id

# ActiveCampaign Custom Field IDs (optional)
AC_LEAD_SCORE_FIELD_ID=your_lead_score_custom_field_id

# Owner Notifications
OWNER_EMAIL=your@email.com
OWNER_PHONE=+61400000000

# Security
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=generate_a_random_32_byte_hex_string_here

# Netlify (for local testing reference)
NETLIFY_SITE_ID=silent-syndicate
NETLIFY_SITE_URL=https://silent-syndicate.netlify.app
